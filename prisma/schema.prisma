generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum IOType {
  Income
  Expenses
}

enum StatieRoomStatus {
  Lobby
  Voting
  Debate
  Collecting
  Finished
}

enum StatieRoundStatus {
  Voting
  Debate
  CollectingTranscripts
  Finished
}

enum StatieVoteChoice {
  Agree
  Disagree
}

enum WerewolfRoomStatus {
  Lobby
  Active
  Finished
}

model User {
  id                 String   @id
  name               String
  email              String   @unique
  emailVerified      Boolean  @default(false)
  image              String?
  profileTheme       Json?
  mcpApiKey          String?  @unique
  currency           String   @default("IDR")
  activeManagementId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions               Session[]
  accounts               Account[]
  memberships            ManagementMember[]
  noteMemberships        NoteMember[]
  createdEntries         Entry[]                  @relation("EntryCreator")
  auditSnapshots         AuditSnapshot[]
  oauthAuthCodes         OAuthAuthorizationCode[]
  oauthTokens            OAuthToken[]
  oauthConsents          OAuthConsent[]
  statieRoomsCreated     StatieRoom[]             @relation("StatieRoomLeader")
  statieParticipations   StatieParticipant[]
  werewolfRoomsCreated   WerewolfRoom[]           @relation("WerewolfRoomLeader")
  werewolfParticipations WerewolfParticipant[]
  expoPushTokens         ExpoPushToken[]
  cloudSponsoredWallets  Management[]
  betaRedemptionCodes    BetaRedemptionCode[]
  lifeFlowEntities       LifeFlowEntity[]

  @@map("User")
}

model StatieRoom {
  id                 String           @id @default(uuid())
  code               String           @unique
  topic              String
  topicKey           String
  status             StatieRoomStatus @default(Lobby)
  leaderUserId       String?
  leaderUser         User?            @relation("StatieRoomLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  leaderGuestName    String?
  leaderToken        String
  votingSeconds      Int              @default(30)
  debateSeconds      Int              @default(900)
  playerLimit        Int              @default(10)
  currentRoundId     String?
  pendingStatementId String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  participants StatieParticipant[]
  rounds       StatieRound[]

  @@index([code])
  @@index([leaderUserId])
  @@index([topicKey])
}

model StatieParticipant {
  id         String     @id @default(uuid())
  roomId     String
  room       StatieRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName  String?
  token      String
  isLeader   Boolean    @default(false)
  joinedAt   DateTime   @default(now())
  lastSeenAt DateTime   @default(now())

  votes       StatieVote[]
  transcripts StatieTranscript[]

  @@unique([roomId, token])
  @@index([roomId])
  @@index([userId])
}

model StatieStatement {
  id            String   @id @default(uuid())
  topic         String
  topicKey      String
  text          String
  generatedByAi Boolean  @default(true)
  usedCount     Int      @default(0)
  agreeCount    Int      @default(0)
  disagreeCount Int      @default(0)
  createdAt     DateTime @default(now())

  rounds StatieRound[]

  @@unique([topicKey, text])
  @@index([topicKey, usedCount])
}

model StatieRound {
  id                   String            @id @default(uuid())
  roomId               String
  room                 StatieRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  statementId          String
  statement            StatieStatement   @relation(fields: [statementId], references: [id], onDelete: Restrict)
  status               StatieRoundStatus @default(Voting)
  votingStartedAt      DateTime          @default(now())
  debateStartedAt      DateTime?
  debateEndsAt         DateTime?
  transcriptDeadlineAt DateTime?
  finishedAt           DateTime?
  aiScore              Json?
  aiScoreError         String?
  aiScoredAt           DateTime?
  createdAt            DateTime          @default(now())

  votes       StatieVote[]
  transcripts StatieTranscript[]

  @@index([roomId, createdAt])
  @@index([statementId])
}

model StatieTranscript {
  id            String            @id @default(uuid())
  roundId       String
  round         StatieRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantId String
  participant   StatieParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  text          String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([roundId, participantId])
  @@index([roundId])
  @@index([participantId])
}

model StatieVote {
  id            String            @id @default(uuid())
  roundId       String
  round         StatieRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantId String
  participant   StatieParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  choice        StatieVoteChoice
  createdAt     DateTime          @default(now())

  @@unique([roundId, participantId])
  @@index([roundId, choice])
}

model WerewolfRoom {
  id              String             @id @default(uuid())
  code            String             @unique
  status          WerewolfRoomStatus @default(Lobby)
  leaderUserId    String?
  leaderUser      User?              @relation("WerewolfRoomLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  leaderGuestName String?
  leaderToken     String
  playerLimit     Int                @default(10)
  availableRoles  String[]           @default(["Werewolf", "Villager"])
  maxWerewolves   Int                @default(2)
  nightSeconds    Int                @default(60)
  daySeconds      Int                @default(120)
  votingSeconds   Int                @default(60)
  revoteSeconds   Int                @default(30)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  participants WerewolfParticipant[]

  @@index([code])
}

model WerewolfParticipant {
  id          String       @id @default(uuid())
  roomId      String
  room        WerewolfRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName   String?
  token       String
  isLeader    Boolean      @default(false)
  isModerator Boolean      @default(false)
  joinedAt    DateTime     @default(now())
  lastSeenAt  DateTime     @default(now())

  @@unique([roomId, token])
  @@index([roomId])
  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("Account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("Verification")
}

model Management {
  id                 String              @id @default(uuid())
  name               String
  category           ManagementCategory?
  image              String?
  imageTheme         Json?
  cloudSponsorUserId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  members          ManagementMember[]
  categories       Category[]
  entries          Entry[]
  quickFills       QuickFill[]
  invitations      Invitation[]
  overallBudgets   OverallBudget[]
  recurringEntries RecurringEntry[]
  auditSnapshots   AuditSnapshot[]
  expoPushTokens   ExpoPushToken[]
  cloudSponsorUser User?              @relation(fields: [cloudSponsorUserId], references: [id])

  @@index([cloudSponsorUserId])
}

enum ManagementCategory {
  CASH
  INVESTMENT
  CREDIT_CARD
  DEBIT_CARD
  LOAN
  SAVINGS
}

model BetaRedemptionCode {
  id               String    @id
  codeHash         String    @unique
  label            String?
  expiresAt        DateTime
  redeemedByUserId String?
  redeemedAt       DateTime?
  grantReference   String?
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  redeemedBy       User?     @relation(fields: [redeemedByUserId], references: [id], onUpdate: NoAction)

  @@index([expiresAt])
  @@index([redeemedByUserId])
}

model LifeFlowEntity {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String
  entityId     String
  payload      Json?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, kind, entityId])
  @@index([userId, updatedAt])
  @@index([userId, kind, deletedAt])
}

model ExpoPushToken {
  id           String      @id @default(uuid())
  token        String      @unique
  platform     String
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  managementId String?
  management   Management? @relation(fields: [managementId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([managementId])
}

model ManagementMember {
  id           String     @id @default(uuid())
  managementId String
  management   Management @relation(fields: [managementId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String     @default("member")
  joinedAt     DateTime   @default(now())

  @@unique([managementId, userId])
}

model Invitation {
  id           String     @id @default(uuid())
  managementId String
  management   Management @relation(fields: [managementId], references: [id], onDelete: Cascade)
  code         String     @unique
  status       String     @default("pending")
  createdAt    DateTime   @default(now())
  expiresAt    DateTime
}

model Note {
  id              String   @id @default(uuid())
  title           String
  icon            String   @default("BookEditIcon")
  iconType        String   @default("hugeicon")
  iconColor       String   @default("default")
  contentJson     String?
  contentHtml     String?
  contentMarkdown String?
  pinned          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members     NoteMember[]
  invitations NoteInvitation[]
}

model NoteMember {
  id       String   @id @default(uuid())
  noteId   String
  note     Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([noteId, userId])
  @@index([userId])
}

model NoteInvitation {
  id        String   @id @default(uuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  code      String   @unique
  status    String   @default("pending")
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([noteId])
}

model OverallBudget {
  id           String     @id @default(uuid())
  managementId String
  management   Management @relation(fields: [managementId], references: [id], onDelete: Cascade)
  period       String
  amount       Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([managementId, period])
}

model RecurringEntry {
  id            String     @id @default(uuid())
  managementId  String
  management    Management @relation(fields: [managementId], references: [id], onDelete: Cascade)
  name          String
  nominal       Float
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  io            IOType
  frequency     String
  reminderTime  String     @default("09:00")
  dayOfWeek     Int?
  dayOfMonth    Int?
  monthOfYear   Int?
  startDate     String
  endDate       String?
  lastGenerated String?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([managementId, active])
  @@index([managementId, frequency])
}

model Category {
  id               String           @id @default(uuid())
  name             String
  color            String           @default("default")
  icon             String?
  budgetDaily      Float?
  budgetWeekly     Float?
  budgetMonthly    Float?
  budgetYearly     Float?
  managementId     String?
  management       Management?      @relation(fields: [managementId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  entries          Entry[]
  quickFills       QuickFill[]
  recurringEntries RecurringEntry[]

  @@unique([name, managementId])
}

model QuickFill {
  id           String      @id @default(uuid())
  name         String
  nominal      Float
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  managementId String?
  management   Management? @relation(fields: [managementId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  order        Int         @default(0)
}

model Entry {
  id                String      @id @default(uuid())
  notionId          String?     @unique
  name              String
  nominal           Float
  originalNominal   Float?
  originalCurrency  String?
  exchangeRateToIdr Float?
  exchangeRateAt    DateTime?
  categoryId        String?
  category          Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  date              String?
  io                IOType?
  managementId      String?
  management        Management? @relation(fields: [managementId], references: [id], onDelete: Cascade)
  createdById       String?
  createdBy         User?       @relation("EntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  isReconciliation  Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([date, createdAt, id])
  @@index([io, date])
  @@index([categoryId])
  @@index([createdAt])
  @@index([managementId])
  @@index([createdById])
}

model AuditSnapshot {
  id                String     @id @default(uuid())
  managementId      String
  management        Management @relation(fields: [managementId], references: [id], onDelete: Cascade)
  date              String
  expectedBalance   Float
  actualBalance     Float
  difference        Float
  adjustmentEntryId String?
  note              String?
  createdById       String
  createdBy         User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())

  @@index([managementId, date])
}

model OAuthClient {
  id            String   @id @default(cuid())
  clientId      String   @unique
  clientSecret  String?
  clientName    String
  clientUri     String?
  logoUri       String?
  redirectUris  String[]
  grantTypes    String[]
  responseTypes String[]
  scope         String?
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authCodes OAuthAuthorizationCode[]
  tokens    OAuthToken[]
  consents  OAuthConsent[]

  @@map("OAuthClient")
}

model OAuthAuthorizationCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  clientId            String
  userId              String
  redirectUri         String
  codeChallenge       String?
  codeChallengeMethod String?
  scopes              String[]
  resource            String?
  expiresAt           DateTime
  used                Boolean  @default(false)
  createdAt           DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId])
  user   User        @relation(fields: [userId], references: [id])

  @@map("OAuthAuthorizationCode")
}

model OAuthToken {
  id           String      @id @default(cuid())
  accessToken  String      @unique
  refreshToken String?     @unique
  clientId     String
  client       OAuthClient @relation(fields: [clientId], references: [clientId])
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  scopes       String[]
  resource     String?
  tokenType    String      @default("Bearer")
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  revokedAt    DateTime?

  @@map("OAuthToken")
}

model OAuthConsent {
  id        String      @id @default(cuid())
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [clientId])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  scopes    String[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([clientId, userId])
  @@map("OAuthConsent")
}
